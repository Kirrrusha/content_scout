# Install as /etc/content_scout/socks-tunnel.env with mode 600.
# Telegram DC IPs are unreachable through a plaintext SOCKS proxy from this VM,
# because DPI on the egress path drops SOCKS5 CONNECT packets that carry a
# Telegram DC IP literal. The tunnel hides the SOCKS handshake inside SSH.
TUNNEL_KEY=/home/scout/.ssh/proxy_tunnel
REMOTE_USER=root
REMOTE_HOST=93.88.204.164
REMOTE_SOCKS_PORT=1080
# Must match the docker network gateway pinned in docker-compose.prod.yml.
BIND_ADDRESS=172.18.0.1
BIND_PORT=1080
